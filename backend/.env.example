# Configurações do Django
DEBUG=True
SECRET_KEY=django-insecure-aapoc-development-secret-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Frontend URLs permitidas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de Dados (Padrão: SQLite local. Em produção: PostgreSQL URL)
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_banco

# Notificações Automáticas de Novos Voluntários
# Número da coordenação com DDI e DDD (ex: 5565992162284)
WHATSAPP_COORDINATION_PHONE=5565992162284
# URL do Webhook do WhatsApp (Evolution API, Z-API, n8n, Make ou webhook personalizado)
# WHATSAPP_NOTIFICATION_WEBHOOK_URL=https://sua-instancia.evolution-api.com/message/sendText/sua_sessao
# E-mail de destino para alertas da coordenação (opcional)
# EMAIL_NOTIFICACAO_DESTINO=contato@aapoc.org.br

